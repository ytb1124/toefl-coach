[{"line": 0, "start": 0.0, "end": 1.55, "t": "Listen to a conversation."}, {"line": 1, "start": 2.1, "end": 5.01, "t": "Are you still going to the concert downtown on Sunday?"}, {"line": 2, "start": 5.56, "end": 11.63, "t": "I'd love to, but my car is in the repair shop until next week, and the buses don't run late on Sundays."}, {"line": 3, "start": 12.18, "end": 13.36, "t": "I can drive you."}, {"line": 3, "start": 13.58, "end": 14.66, "t": "I'm going anyway."}, {"line": 4, "start": 15.22, "end": 15.64, "t": "Really?"}, {"line": 4, "start": 15.86, "end": 16.78, "t": "That would be great."}, {"line": 4, "start": 17.0, "end": 18.57, "t": "I was worried I'd have to miss it."}]