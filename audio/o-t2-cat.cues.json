[{"line": 0, "start": 0.0, "end": 1.55, "t": "Listen to a conversation."}, {"line": 1, "start": 2.1, "end": 3.68, "t": "Did you feed the cat this morning?"}, {"line": 1, "start": 3.9, "end": 5.64, "t": "She's been meowing all afternoon."}, {"line": 2, "start": 6.19, "end": 7.2, "t": "Oh, no!"}, {"line": 2, "start": 7.42, "end": 8.77, "t": "I completely forgot."}, {"line": 2, "start": 8.99, "end": 13.35, "t": "I was watering the flowers in the garden, and then I got a call from a client."}, {"line": 3, "start": 13.91, "end": 14.57, "t": "Poor cat!"}, {"line": 3, "start": 14.79, "end": 16.12, "t": "She must be so hungry."}, {"line": 4, "start": 16.67, "end": 21.11, "t": "And now I've got a conference call coming up, and I need to look over my notes."}, {"line": 5, "start": 21.66, "end": 22.83, "t": "You focus on that."}, {"line": 5, "start": 23.05, "end": 24.45, "t": "I'll take care of the cat."}]