[{"line": 0, "start": 0.0, "end": 1.55, "t": "Listen to a conversation."}, {"line": 1, "start": 2.1, "end": 4.67, "t": "Are you coming to the open mic night on Friday?"}, {"line": 1, "start": 4.89, "end": 6.35, "t": "The music club is running it."}, {"line": 2, "start": 6.9, "end": 7.69, "t": "Definitely."}, {"line": 2, "start": 7.91, "end": 10.98, "t": "The last one was great—I laughed the whole time."}, {"line": 3, "start": 11.53, "end": 13.05, "t": "You play guitar, right?"}, {"line": 3, "start": 13.27, "end": 14.28, "t": "You should sign up."}, {"line": 4, "start": 14.83, "end": 16.62, "t": "Oh no, I'll just watch."}, {"line": 4, "start": 16.85, "end": 19.5, "t": "Playing in front of a crowd makes my hands shake."}]