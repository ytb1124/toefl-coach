[{"line": 0, "start": 0.0, "end": 1.55, "t": "Listen to a conversation."}, {"line": 1, "start": 2.1, "end": 4.51, "t": "Are you going to Jamie's party this weekend?"}, {"line": 1, "start": 4.73, "end": 6.85, "t": "I heard it's going to be pretty lively."}, {"line": 2, "start": 7.4, "end": 8.08, "t": "Definitely."}, {"line": 2, "start": 8.3, "end": 12.23, "t": "I heard there's going to be a karaoke competition and a taco buffet."}, {"line": 3, "start": 12.79, "end": 14.07, "t": "That sounds amazing."}, {"line": 3, "start": 14.3, "end": 18.4, "t": "I hope someone records the karaoke—those are always hilarious."}, {"line": 4, "start": 18.95, "end": 20.2, "t": "Oh, about that..."}, {"line": 4, "start": 20.42, "end": 23.2, "t": "Jamie actually asked me to host the karaoke."}, {"line": 4, "start": 23.42, "end": 24.81, "t": "I've never done that before!"}, {"line": 5, "start": 25.36, "end": 26.24, "t": "You'll be great."}, {"line": 5, "start": 26.46, "end": 28.47, "t": "Just don't expect me to join in!"}, {"line": 5, "start": 28.69, "end": 30.02, "t": "I have stage fright."}]